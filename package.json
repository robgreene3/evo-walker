{
  "name": "evowalker",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@11.9.0",
  "engines": {
    "node": ">=20.19.0"
  },
  "scripts": {
    "dev": "pnpm --filter @evowalker/web dev",
    "demo:episode": "pnpm build:packages && pnpm --filter @evowalker/sim episode",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "lint": "eslint .",
    "typecheck": "tsc -p tsconfig.json --pretty false",
    "test": "vitest run",
    "test:core": "vitest run packages/core",
    "test:sim": "vitest run packages/sim",
    "test:e2e": "playwright test",
    "benchmark": "pnpm build:packages && vitest run --config vitest.benchmark.config.ts",
    "build:packages": "tsc -b tsconfig.build.json --pretty false",
    "build": "pnpm build:packages && pnpm --filter @evowalker/web build",
    "verify:core": "pnpm format:check && pnpm lint && pnpm typecheck && pnpm test && pnpm benchmark && pnpm --filter @evowalker/web build",
    "verify": "pnpm verify:core && pnpm test:e2e"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@playwright/test": "1.62.1",
    "@types/node": "26.1.2",
    "@types/react": "19.2.18",
    "@types/react-dom": "19.2.4",
    "@types/three": "0.185.1",
    "eslint": "10.8.0",
    "eslint-plugin-react-hooks": "7.1.1",
    "prettier": "3.9.6",
    "typescript": "6.0.3",
    "typescript-eslint": "8.65.0",
    "vite": "8.2.0",
    "vitest": "4.1.10"
  }
}
