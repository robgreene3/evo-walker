{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    "rootDir": "src",
    "outDir": "dist",
    "tsBuildInfoFile": "dist/.tsbuildinfo",
    "types": ["node"],
    "paths": {
      "@evowalker/core": ["../core/src/index.ts"],
      "@evowalker/sim": ["../sim/src/index.ts"]
    }
  },
  "include": ["src/**/*.ts"],
  "references": [
    { "path": "../core/tsconfig.build.json" },
    { "path": "../sim/tsconfig.build.json" }
  ]
}
